# Server Port (Render sets this automatically in production)
PORT=5000

# MongoDB Connection String:
# For local development: mongodb://127.0.0.1:27017/college_quiz_system
# For MongoDB Atlas production: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/college_quiz_system?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/college_quiz_system

# Application Session Secret
SESSION_SECRET=your_strong_random_session_secret_key_here

# Initial Seed Admin Account (used only on first seed/setup)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_this_secure_password_123

# Node Environment ('development' locally, 'production' on Render)
NODE_ENV=production
